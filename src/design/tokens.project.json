{
  "$schema": "./tokens.schema.json",
  "format": "metritag-css-tokens-v1",
  "source": "DESIGN.md",
  "blocks": [
    {
      "selector": "body",
      "values": {
        "--mt-fill-1": "#F7F8FA",
        "--mt-theme-1": "#E8F2FF",
        "--mt-theme-6": "#005BF5",
        "--mt-warn-bg": "#FFF4E6",
        "--mt-error-bg": "#FFECE8",
        "--mt-chart-series": "#0EB9CC",
        "--chart-series-1": "#005BF5",
        "--chart-series-2": "#0E7C8A",
        "--chart-series-3": "#C25400",
        "--chart-series-4": "#8B5CF6",
        "--mt-fill-2": "#F2F3F5",
        "--app-control-border": "#DDDDDD",
        "--app-color-primary": "rgb(var(--primary-6))",
        "--app-on-accent": "#FFFFFF",
        "--app-color-success": "rgb(var(--success-6))",
        "--app-color-warning": "rgb(var(--warning-6))",
        "--app-color-danger": "rgb(var(--danger-6))",
        "--app-surface-page": "var(--color-bg-1)",
        "--app-surface-container": "var(--color-bg-2)",
        "--app-surface-popup": "var(--color-bg-popup)",
        "--app-text-primary": "var(--color-text-1)",
        "--app-text-secondary": "var(--color-text-2)",
        "--app-text-muted": "var(--color-text-3)",
        "--app-divider": "var(--color-border-2)",
        "--app-table-header": "#F6F7F9",
        "--app-spacing-page": "32px",
        "--app-radius-control": "var(--border-radius-medium, 4px)",
        "--app-notice-surface": "#FFFFFF",
        "--app-notice-title": "#333333",
        "--app-notice-copy": "#666666",
        "--app-notice-muted": "#999999",
        "--app-notice-indicator": "#D40000",
        "--app-notice-radius": "4px",
        "--app-login-bg": "url('../assets/login-bg.svg')",
        "--app-login-bg-fill": "#070F23",
        "--app-notice-shadow": "0 1px 2px -2px rgba(0,0,0,.16), 0 3px 6px 0 rgba(0,0,0,.12), 0 5px 12px 4px rgba(0,0,0,.08)",
        "--app-shadow-4": "0 2px 6px rgba(0,0,0,.06)",
        "--primary-5": "45, 126, 247",
        "--primary-6": "0, 91, 245",
        "--primary-7": "0, 68, 203",
        "--link-5": "var(--primary-5)",
        "--link-6": "var(--primary-6)",
        "--link-7": "var(--primary-7)",
        "--app-confirm-icon": "#FF6B00",
        "--app-confirm-desc": "#999999",
        "--app-assistant-shadow": "0 4px 12px rgba(0, 0, 0, .16)",
        "--app-assistant-panel-shadow": "0 8px 28px rgba(0, 0, 0, .18)",
        "--app-import-help-surface": "var(--color-primary-light-1)",
        "--app-print-canvas": "#f2f3f5",
        "--app-print-text": "#1d2129",
        "--app-print-border": "#d9d9d9",
        "--app-print-paper": "#ffffff",
        "--app-print-primary": "#005bf5",
        "--app-print-primary-hover": "#3f7ff8",
        "--app-print-secondary": "#4e5969",
        "--app-print-muted": "#86909c",
        "--app-print-divider": "#c9cdd4",
        "--app-print-shadow": "0 2px 8px rgba(0, 0, 0, 0.08)",
        "--app-matching-auto-na": "#E7E6E6",
        "--app-matching-manual-na": "#D0CECE"
      }
    },
    {
      "selector": "body[arco-theme='dark'], html body[arco-theme='dark']",
      "values": {
        "--mt-fill-1": "var(--color-bg-1)",
        "--mt-theme-1": "var(--color-primary-light-1)",
        "--mt-theme-6": "#4D8DF8",
        "--mt-warn-bg": "var(--color-warning-light-1)",
        "--mt-error-bg": "var(--color-danger-light-1)",
        "--mt-chart-series": "#1DE4F3",
        "--chart-series-1": "#6FA5FF",
        "--chart-series-2": "#1DE4F3",
        "--chart-series-3": "#FF9A4D",
        "--chart-series-4": "#B18AFF",
        "--mt-fill-2": "#2E3138",
        "--app-control-border": "#6E7684",
        "--app-table-header": "var(--color-fill-2)",
        "--primary-5": "111, 165, 255",
        "--primary-6": "77, 141, 248",
        "--primary-7": "45, 126, 247",
        "--link-5": "var(--primary-5)",
        "--link-6": "var(--primary-6)",
        "--link-7": "var(--primary-7)",
        "--app-confirm-icon": "var(--app-color-warning)",
        "--app-confirm-desc": "var(--app-text-muted)",
        "--app-matching-auto-na": "var(--color-fill-2)",
        "--app-matching-manual-na": "var(--color-fill-3)"
      }
    }
  ],
  "migrationNote": "Existing implementation-only assistant, print, skeleton and matching values are centralized project extensions. Primary/link adapters follow DESIGN.md measured interaction ramp."
}
